            "description": "Exchanges the refresh token for a new access token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.access !== undefined) pm.collectionVariables.set(\"access\", json.access);",
                  "}"
                ]
              }
            }
          ]
        },

            "description": "Enables 2FA once a valid code from the authenticator is sent. Returns 10 one-time `recovery_codes`, shown only this once; the first is saved to `recovery_code`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"

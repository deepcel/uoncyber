{
  "info": {
    "name": "DefendEd API",
    "description": "All routed endpoints of the DefendEd Django backend (accounts + modules).\n\n1. Start the server: `python manage.py runserver`.\n2. Run **Accounts > Register**, then **Login**. The access token is saved and sent as a Bearer token on every other request.\n3. New accounts have role USER. To test module authoring, set the role to OWNER or ADMIN in Django admin or `manage.py shell`, then log in again.\n4. Create requests save their ids (`module_id`, `section_id`, ...) for the requests after them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "alice"
    },
    {
      "key": "email",
      "value": "alice@example.com"
    },
    {
      "key": "password",
      "value": "S3cure-pass!"
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "recovery_code",
      "value": ""
    },
    {
      "key": "target_user_id",
      "value": ""
    },
    {
      "key": "learner_id",
      "value": ""
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "challenge_id",
      "value": ""
    },
    {
      "key": "totp_secret",
      "value": ""
    },
    {
      "key": "module_id",
      "value": ""
    },
    {
      "key": "section_id",
      "value": ""
    },
    {
      "key": "pathway_id",
      "value": ""
    },
    {
      "key": "enrollment_id",
      "value": ""
    }

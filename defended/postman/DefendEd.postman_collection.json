  "item": [
    {
      "name": "Accounts",
      "description": "Registration, login, 2FA and current user profile.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "register",
                ""
              ]
            },
            "description": "Creates a USER-role account. Any `role` sent is ignored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "login",
                ""
              ]
            },
            "description": "If 2FA is off: returns `access` + `refresh` (saved automatically).\nIf 2FA is on: returns `mfa_required: true` and a `challenge_id` (saved automatically), then run **Login - 2FA**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.access !== undefined) pm.collectionVariables.set(\"access\", json.access);",
                  "  if (json.refresh !== undefined) pm.collectionVariables.set(\"refresh\", json.refresh);",
                  "  if (json.challenge_id !== undefined) pm.collectionVariables.set(\"challenge_id\", json.challenge_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - 2FA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/login/2fa/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "login",
                "2fa",
                ""
              ]
            },
            "description": "Set the `otp` collection variable to the current 6-digit code from your authenticator app first. The challenge expires after 5 minutes and can be used once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challenge_id}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.access !== undefined) pm.collectionVariables.set(\"access\", json.access);",
                  "  if (json.refresh !== undefined) pm.collectionVariables.set(\"refresh\", json.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - 2FA with recovery code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/login/2fa/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "login",
                "2fa",
                ""
              ]
            },
            "description": "Lost phone: use one of the recovery codes from **2FA - Verify** instead of `otp`. Each code works once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challenge_id}}\",\n  \"recovery_code\": \"{{recovery_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.access !== undefined) pm.collectionVariables.set(\"access\", json.access);",
                  "  if (json.refresh !== undefined) pm.collectionVariables.set(\"refresh\", json.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

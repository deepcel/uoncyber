                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.recovery_codes[0] !== undefined) pm.collectionVariables.set(\"recovery_code\", json.recovery_codes[0]);",
                  "}"
                ]
              }
            }
          ]
        },
